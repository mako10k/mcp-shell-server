{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@mako10k/mcp-shell-server/tool-runtime": [
        "../../dist/runtime/tool-runtime.d.ts"
      ]
    },
    "strict": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "types": ["vscode", "node"],
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
